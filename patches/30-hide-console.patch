+#ifdef __CYGWIN__
+	/*
+	 * When started from a GUI program without CREATE_NO_WINDOW, Windows
+	 * gives sshfs a new console window of its own. Hide it if no other
+	 * process shares the console (i.e. not started from a terminal).
+	 */
+	{
+		unsigned long pids[2];
+		void *hwnd = GetConsoleWindow();
+		if (hwnd && GetConsoleProcessList(pids, 2) == 1)
+			ShowWindow(hwnd, 0 /* SW_HIDE */);
+	}
+#endif
